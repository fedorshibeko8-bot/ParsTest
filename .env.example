# ==== Образец настроек бота ====
# Скопируйте этот файл в .env (в той же папке) и заполните значения.
# Файл .env в git не попадает, реальные ключи в репозиторий не коммитим.
# Пример для Windows: copy .env.example .env
#
# Значения PASTE_... - заглушки. Пока стоит DRY_RUN=1, ключи ИИ и CHANNEL_ID
# можно не заполнять: бот работает без публикаций и без обращений к ИИ.
# BOT_TOKEN обязателен всегда - без него бот не подключится к Telegram.


# ==== Telegram (обязательно) ====

# Токен бота, его выдаёт @BotFather в Telegram.
# Формат: 123456789:AA... (длинная строка). Не публикуйте токен.
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# ID канала для публикации: числовой ID вида -1001234567890 или @username.
# Бот должен быть администратором канала с правом публикации сообщений.
# Обязателен только при DRY_RUN=0.
CHANNEL_ID=PASTE_CHANNEL_ID

# Числовые Telegram ID администраторов через запятую (без @username).
# Свой ID можно узнать у бота @userinfobot. Пример: 123456789,987654321
ADMIN_IDS=PASTE_ADMIN_IDS

# Тихий режим публикации: 1 - посты уходят без звука (disable_notification),
# 0 - обычное уведомление подписчиков. По умолчанию 0.
PUBLISH_SILENT=0


# ==== Режим работы ====

# 1 - режим заглушек: без публикации в канал и без запросов к ИИ (безопасно).
# 0 - боевой режим: нужны реальный CHANNEL_ID и хотя бы один ключ ИИ.
DRY_RUN=1

# Уровень логов: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO


# ==== Ключи ИИ (вне DRY_RUN нужен хотя бы один) ====

# Ключ Gemini API (бесплатный тариф), основной провайдер рерайта.
GEMINI_API_KEY=PASTE_GEMINI_API_KEY

# Модель Gemini. По умолчанию Flash-Lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Ключ Groq API — необязательный запасной провайдер.
# Пусто = фоллбэк отключён, рерайт идёт только через Gemini.
GROQ_API_KEY=

# Модель Groq для фоллбэка (используется, только если задан ключ выше).
GROQ_MODEL=openai/gpt-oss-120b


# ==== Файлы и каталоги ====
# Относительные пути считаются от папки проекта. Каталоги создаются автоматически.

# Файл базы SQLite (в git не попадает).
DATABASE_PATH=data/bot.db

# Куда скачивать картинки новостей.
IMAGES_DIR=data/images

# Максимальный размер картинки, МБ. Больше - не скачиваем (лимит и для
# автоматических картинок, и для ручной замены в карточке).
IMAGE_MAX_MB=10

# Через сколько часов после published/dropped удалять файл картинки.
# Сама запись в БД остаётся, очищается только путь к файлу.
IMAGE_KEEP_HOURS=48

# Куда писать логи (bot.log с ротацией по дням, хранение 30 дней).
LOGS_DIR=logs


# ==== Опрос RSS ====

# Интервал опроса каждого источника, секунды. 300-600 = раз в 5-10 минут.
# Реальное время внутри интервала выбирается случайно (jitter).
POLL_INTERVAL_MIN_SEC=300
POLL_INTERVAL_MAX_SEC=600

# Таймаут HTTP-запроса к источнику или API, секунды.
HTTP_TIMEOUT_SEC=20


# ==== Отбор новостей ====

# Ключевые слова через запятую (регистр не важен).
# Если оставить пустым, используются значения по умолчанию:
# GTA 6, GTA VI, Grand Theft Auto, Rockstar.
# Варианты написания (GTA-6, GTA6, GTA–6) распознаются автоматически.
NEWS_KEYWORDS=GTA 6, GTA VI, Grand Theft Auto, Rockstar


# ==== Очередь и жизненный цикл поста ====

# Сколько часов пост может висеть в очереди (pending), потом - dropped.
POST_TTL_HOURS=48

# Тайм-аут бездействия владельца поста, минуты. Потом пост возвращается в очередь.
INTERCEPT_TIMEOUT_MINUTES=10

# Сколько самых свежих постов очереди видит админ.
QUEUE_VISIBLE_LIMIT=10


# ==== Дедупликация ====

# Схожесть заголовков: >= этого порога - дубль, молча пропускаем.
DEDUP_DUPLICATE_THRESHOLD=0.85

# Схожесть от этого порога до порога дубля - "серая зона":
# показываем админу с пометкой, решение принимает человек.
DEDUP_GRAY_ZONE_THRESHOLD=0.70
