# Единые переводы строк: в репозитории LF, на диске — как решит git.
* text=auto eol=lf

# Явно бинарные
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.zip binary

# Windows-скрипты остаются CRLF, чтобы корректно работали в cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf
